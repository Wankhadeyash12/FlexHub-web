# MongoDB Configuration
# For local development: mongodb://localhost:27017/flexhub
# For production (Vercel): Get from MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/flexhub?retryWrites=true&w=majority

# Server Port (Vercel ignores this, but needed for local dev)
PORT=3000

# JWT Secret - Use a strong random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_key_here_min_32_chars

# Razorpay Configuration (Payment Gateway)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Base URL for redirects (after payment)
# Local: http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
BASE_URL=http://localhost:3000

# Uploads Directory (for local development)
UPLOADS_DIR=server/uploads
